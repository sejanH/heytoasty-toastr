{
  "name": "heytoasty",
  "version": "0.1.0",
  "description": "A tiny vanilla JS/TS toast notification library extracted from the HeyToasty admin panel. Zero dependencies, injected CSS, imperative API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "homepage": "https://heytoasty.sejan.workers.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sejanH/heytoasty-toastr.git"
  },
  "bugs": {
    "url": "https://github.com/sejanH/heytoasty-toastr/issues"
  },
  "files": [
    "dist",
    "heytoasty.jpeg"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "toast",
    "notification",
    "alert",
    "toastr",
    "ui",
    "vanilla"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
